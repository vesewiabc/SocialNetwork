#include "colors.inc"
#include "textures.inc"

global_settings {
  ambient_light White
}

camera {
  location <0, 5, -20>
  look_at <20, -5, 40>
  angle 60
}

light_source {
  <10, 15, -5>
  color White
}

light_source {
  <0, 8, 0>
  color White
}

background { color NeonBlue }

plane {
  y, 0
  pigment { checker color White, color Gray20 scale 1.5 }
  finish { ambient 0.2 diffuse 0.8 }
}

// ========== СТОЛ ==========

box {
  <-1.8, 0, -1.5>, 
  <-1.5, 1.5, 1.5>
  pigment { Brown }
  finish { phong 0.6 }
}

// Правая перегородка (боковая стенка)
box {
  <1.5, 0, -1.5>, 
  <1.8, 1.5, 1.5>
  pigment { Brown }
  finish { phong 0.6 }
}

// Столешница (две части с дыркой справа)
// Левая часть столешницы
box {
  <-1.8, 1.5, -1.5>, <1.0, 1.65, 1.5>
  pigment { color rgb <0.7, 0.5, 0.2> }
  finish { phong 0.7 reflection 0.1 }
}

// Правая часть столешницы (после дырки)
box {
  <1.25, 1.5, -1.5>, <1.8, 1.65, 1.5>
  pigment { color rgb <0.7, 0.5, 0.2> }
  finish { phong 0.7 reflection 0.1 }
}

// Дырка под провода — передняя часть столешницы (перед дыркой по Z)
box {
  <1.0, 1.5, -1.5>, <1.25, 1.65, 0.8>
  pigment { color rgb <0.7, 0.5, 0.2> }
  finish { phong 0.7 reflection 0.1 }
}

// Дырка под провода — задняя часть столешницы (за дыркой по Z)
box {
  <1.0, 1.5, 1.1>, <1.25, 1.65, 1.5>
  pigment { color rgb <0.7, 0.5, 0.2> }
  finish { phong 0.7 reflection 0.1 }
}

// Скруглённая дырка (тёмный цилиндр сверху)
cylinder {
  <1.125, 1.5, 0.95>, <1.125, 1.66, 0.95>, 0.15
  pigment { color rgb <0.15, 0.08, 0.02> }
  finish { ambient 0.1 diffuse 0.3 }
}

// ========== МЫШКА ==========

// Корпус мышки
difference {
  sphere {
    <-0.3, 1.65, 0.3>, 0.18
    scale <1.2, 0.5, 1.6>
    pigment { color rgb <0.15, 0.15, 0.15> }
    finish { phong 0.8 reflection 0.05 }
  }
  // Срез снизу чтобы лежала ровно
  box {
    <-1, 1.0, -1>, <1, 1.645, 1>
    pigment { color rgb <0.15, 0.15, 0.15> }
  }
}

// Левая кнопка мышки
box {
  <-0.45, 1.735, 0.15>, <-0.31, 1.75, 0.55>
  pigment { color rgb <0.2, 0.2, 0.2> }
  finish { phong 0.9 }
}

// Правая кнопка мышки
box {
  <-0.29, 1.735, 0.15>, <-0.15, 1.75, 0.55>
  pigment { color rgb <0.2, 0.2, 0.2> }
  finish { phong 0.9 }
}

// Колёсико прокрутки
cylinder {
  <-0.3, 1.75, 0.3>, <-0.3, 1.76, 0.45>, 0.03
  rotate <90, 0, 0>
  pigment { color rgb <0.4, 0.4, 0.4> }
  finish { phong 1.0 }
}

// Провод от мышки к дырке
sphere_sweep {
  b_spline 4,
  <-0.3, 1.66, 0.1>, 0.012
  <0.2,  1.66, 0.5>, 0.012
  <0.8,  1.66, 0.8>, 0.012
  <1.125, 1.66, 0.95>, 0.012
  pigment { color rgb <0.1, 0.1, 0.1> }
  finish { phong 0.3 }
}

// Клавиатура
box {
  <-0.5, 1.65, -0.6>, 
  <1, 1.75, -1.1>
  texture {                  
    pigment {
      image_map {
        png "gifs/Klava.png" 
        map_type 0
        interpolate 2
      }
      scale <1.5, 0.1, 0.5>
      translate <0.25, 0, -0.25>
    }
    finish { 
      ambient 0.3 
      diffuse 0.7
    }
  }
}

// ========== МОНИТОР ==========

cylinder { 
  <0, 1.65, -0.15>, 
  <0, 2, -0.15>, 
  0.08
  pigment { Black }
  finish { phong 0.5 }
}

box {
  <-1, 2, -0.1>, 
  <1, 2.8, -0.2>
  texture {                  
    pigment {
      image_map {
        png "gifs/monic.png" 
        map_type 2
        interpolate 2
        once
      }
      scale <2, 0.8, 1>
      translate <0, 2, 0>
    }
    finish { 
      ambient 0.3 
      diffuse 0.7
    }
  }
}

box {
  <-1.05, 1.95, -0.05>, 
  <1.05, 2.85, -0.18>
  pigment { Black }
  finish { phong 0.5 }
}

// Тумба под столом
box {
  <0.8, 1.2, 1>, 
  <1.7, 0, -1>
  texture {                  
    pigment {
      image_map {
        png "gifs/sis.png" 
        map_type 1
        interpolate 2
        once
      }
      scale <0.6, 0.6, 1>
      translate<1.25, 0.6, 0>
    }
    finish { 
      ambient 0.3 
      diffuse 0.7
    }
  }
}

